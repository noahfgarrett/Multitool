{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Multitool",
  "version": "4.7.2",
  "identifier": "com.visualizebuild.multitool",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:tauri-web",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Multitool",
        "width": 1440,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Professional-grade local toolbox",
    "longDescription": "Professional-grade local toolbox for documents, images, files, creators, and utilities.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
